{
  "manifest_version": 3,
  "name": "TailorCV \u2014 AI Resume Optimizer",
  "version": "3.2.5",
  "description": "Tailor your resume to any job posting and write a matching cover letter — download both as ATS-ready PDFs in one click.",
  "permissions": [
    "activeTab",
    "cookies",
    "downloads",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*.linkedin.com/*",
    "*://*.indeed.com/*",
    "*://*.naukri.com/*",
    "*://*.greenhouse.io/*",
    "*://*.lever.co/*",
    "*://*.myworkdayjobs.com/*",
    "*://*.myworkdaysite.com/*",
    "*://*.ashbyhq.com/*",
    "*://*.glassdoor.com/*",
    "*://*.glassdoor.co.in/*",
    "*://*.ziprecruiter.com/*",
    "*://*.monster.com/*",
    "*://*.simplyhired.com/*",
    "*://*.dice.com/*",
    "*://*.wellfound.com/*",
    "https://thetailorcv.com/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://thetailorcv.com/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/jobs/*",
        "*://*.indeed.com/*",
        "*://*.naukri.com/*",
        "*://*.greenhouse.io/*",
        "*://*.lever.co/*",
        "*://*.myworkdayjobs.com/*",
        "*://*.myworkdaysite.com/*",
        "*://*.ashbyhq.com/*",
        "*://*.glassdoor.com/*",
        "*://*.glassdoor.co.in/*",
        "*://*.ziprecruiter.com/*",
        "*://*.monster.com/*",
        "*://*.simplyhired.com/*",
        "*://*.dice.com/*",
        "*://*.wellfound.com/*"
      ],
      "js": [
        "styles.bundle.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Tailor my resume to this job",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.png",
        "icons/*.svg"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
