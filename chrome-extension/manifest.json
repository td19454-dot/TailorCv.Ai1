{
  "manifest_version": 3,
  "name": "TailorCV — AI Resume Tailor for Any Job",
  "version": "3.0.0",
  "description": "Tailor your resume to any job posting and download it in one click — LinkedIn, Indeed, Naukri, Greenhouse, Lever, Workday, and any other job page.",
  "permissions": ["storage", "tabs", "activeTab", "scripting", "cookies", "downloads"],
  "host_permissions": [
    "*://*.linkedin.com/*",
    "*://*.indeed.com/*",
    "*://*.naukri.com/*",
    "*://*.greenhouse.io/*",
    "*://*.lever.co/*",
    "*://*.myworkdayjobs.com/*",
    "*://*.myworkdaysite.com/*",
    "*://*.ashbyhq.com/*",
    "*://*.glassdoor.com/*",
    "*://*.glassdoor.co.in/*",
    "*://*.ziprecruiter.com/*",
    "*://*.monster.com/*",
    "*://*.simplyhired.com/*",
    "*://*.dice.com/*",
    "*://*.wellfound.com/*",
    "https://thetailorcv.com/*",
    "http://127.0.0.1:8005/*",
    "http://localhost:8005/*"
  ],
  "optional_host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/jobs/*",
        "*://*.indeed.com/*",
        "*://*.naukri.com/*",
        "*://*.greenhouse.io/*",
        "*://*.lever.co/*",
        "*://*.myworkdayjobs.com/*",
        "*://*.myworkdaysite.com/*",
        "*://*.ashbyhq.com/*",
        "*://*.glassdoor.com/*",
        "*://*.glassdoor.co.in/*",
        "*://*.ziprecruiter.com/*",
        "*://*.monster.com/*",
        "*://*.simplyhired.com/*",
        "*://*.dice.com/*",
        "*://*.wellfound.com/*"
      ],
      "js": ["content.js"],
      "css": ["sidebar.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Tailor my resume to this job",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
