{
  "manifest_version": 3,
  "name": "TailorCV — AI Resume Optimizer",
  "version": "2.1.0",
  "description": "Automatically tailor your resume to any LinkedIn job posting and download it in one click",
  "permissions": ["activeTab", "cookies", "downloads", "scripting"],
  "host_permissions": [
    "*://*.linkedin.com/*",
    "https://thetailorcv.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.linkedin.com/jobs/*"],
      "js": ["content_linkedin.js"],
      "css": ["sidebar.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*.png"],
      "matches": ["*://*.linkedin.com/*"]
    }
  ]
}
